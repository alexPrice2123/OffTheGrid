anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -1.0
offset_bottom = -1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_jxero")
_lineTable = PackedStringArray("Man, I\'m going to have to get use to driving up that hill to reach the cabin. At least it\'s not as bad as that other hill a few miles back.", "Moving in sure has been tough, especially on my own. But that doesn\'t matter. I\'m far away from the city and on my own, it\'s almost like a dream.", "I should put some boxes away before it gets too crowded.", "Cutscene1", "Um, I suppose that\'s not supposed to happen. I think the previous owner said something about frequent power outages. Maybe a few fuses are missing?", "They gave me this device, said it would help me find some fuses around the house. I\'ll give it a shot.", "Cutscene2", "What the hell was that?!?", "I should turn the power back on, fast!", "Finally... The power is back on.", "What was that thing! I couldn\'t even see it without this weird device.", "I\'m definitely moving out, no way I\'m sticking around here any longer! ")

